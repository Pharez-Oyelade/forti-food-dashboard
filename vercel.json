{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/client/dist/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/v1/cron/automations",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/v1/cron/snapshot",
      "schedule": "0 2 * * 5"
    }
  ]
}
